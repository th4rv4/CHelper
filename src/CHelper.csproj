<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CHelper</RootNamespace>
    <AssemblyName>CHelper</AssemblyName>
    <Version>0.9.5</Version>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Framework-dependent: small exe, needs the .NET 8 Desktop Runtime (the installer adds it if missing) -->
    <SelfContained>false</SelfContained>
    <!-- Lower memory in the background: no ICU culture data (English-only UI), no background GC thread -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\*.png" LogicalName="%(Filename)%(Extension)" />
    <EmbeddedResource Include="Resources\app.ico" LogicalName="app.ico" />
    <!-- Optional vendor DLL (vendor/README.md): when present it is built into the exe -->
    <EmbeddedResource Include="..\vendor\InsydeDCHU.dll" LogicalName="InsydeDCHU.dll" Condition="Exists('..\vendor\InsydeDCHU.dll')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

</Project>
